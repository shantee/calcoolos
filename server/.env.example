# Configuration de l'API Calcoolos — modèle SANS secret.
# Copier en `server/.env` (jamais versionné) ou définir ces variables dans le pool PHP-FPM.

# dev | prod
APP_ENV=prod

# Base MariaDB (production) :
#   DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=calcoolos;charset=utf8mb4
# Base SQLite (développement uniquement) :
#   DB_DSN=sqlite:/chemin/absolu/calcoolos.sqlite
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=calcoolos;charset=utf8mb4
DB_USER=calcoolos
# Mot de passe de l'utilisateur MariaDB : à créer SUR LE SERVEUR, jamais dans le dépôt.
DB_PASSWORD=

# Clé secrète (au moins 32 caractères aléatoires) : sert à anonymiser les adresses IP
# dans la table des tentatives. Générer sur le serveur avec :  openssl rand -hex 32
APP_SECRET=

# 1 en HTTPS (production derrière Cloudflare) : cookie de session « Secure ».
COOKIE_SECURE=1

# Dossier où PHP range les sessions et les fichiers temporaires de l'API
# (doit être hors de la racine web et inscriptible par PHP-FPM).
VAR_DIR=/var/lib/calcoolos
