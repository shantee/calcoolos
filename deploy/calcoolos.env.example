# /etc/calcoolos/calcoolos.env — configuration de production (MODÈLE, sans secret).
# sudo install -m 640 -o root -g calcoolos deploy/calcoolos.env.example /etc/calcoolos/calcoolos.env
# puis compléter les deux valeurs vides SUR LE SERVEUR.
APP_ENV=prod
DB_DSN=mysql:host=localhost;dbname=calcoolos;charset=utf8mb4
DB_USER=calcoolos
DB_PASSWORD=
APP_SECRET=
COOKIE_SECURE=1
VAR_DIR=/var/lib/calcoolos
